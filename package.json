{
  "name": "quick-zaim-ext",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "pnpm exec oxfmt . && pnpm exec turbo run generate && pnpm exec oxlint . && pnpm exec turbo run test && pnpm exec turbo run build",
    "dev": "pnpm exec turbo run dev --filter=server --filter=extension",
    "test": "vitest run",
    "test:browser": "docker compose -f docker-compose.vrt.yml run --build --rm vrt",
    "test:browser:update": "docker compose -f docker-compose.vrt.yml run --build --rm vrt pnpm run test:browser -- --update",
    "prepare": "node -e \"if(!process.env.CI)require('child_process').execSync('lefthook install',{stdio:'inherit'})\""
  },
  "devDependencies": {
    "@hono/cli": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/browser": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "turbo": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.1.1"
}
