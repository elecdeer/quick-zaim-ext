{
  "manifest_version": 3,
  "name": "Quick Zaim",
  "description": "Zaimへの支出を素早く記録するChrome拡張機能",
  "version": "0.0.0",
  "permissions": ["storage", "sidePanel", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {},
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" }
}
