{
  "name": "@repo/zaim-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/generated/index.ts",
    "./client": "./src/generated/client/index.ts",
    "./oauth/*": "./src/oauth/*.ts"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "generate": "pnpm run generate:openapi3 && pnpm run generate:ts-client",
    "generate:openapi3": "tsp compile ./typespec",
    "generate:ts-client": "openapi-ts",
    "build": "tsdown"
  },
  "dependencies": {
    "@tanstack/react-query": "catalog:"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "catalog:",
    "@typespec/compiler": "catalog:",
    "@typespec/http": "catalog:",
    "@typespec/openapi3": "catalog:",
    "msw": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
