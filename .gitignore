# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Wrangler
.wrangler/
.dev.vars

# Local environment files for scripts (e.g. eval scripts)
.env

# LLM eval script outputs
apps/ledger/scripts/eval-results/

# AI agent worktrees
.claude/worktrees/

# Void generated types, local state and Cloudflare config (auto-generated by void prepare / vp dev)
.void/
.void-wrangler.jsonc

# WXT extension build output
.output/

# Storybook build output
storybook-static/

# WXT generated types (auto-generated by wxt prepare / pnpm install)
.wxt/

# Vitest browser test attachments (差分・失敗時スクリーンショット。参照画像は __screenshots__/ で管理)
.vitest-attachments/

# Vitest browser-mode が toMatchScreenshot を使わないテストに対しても
# __screenshots__/ を自動生成する。参照画像は明示的に -chromium-linux.png 名で
# コミットしたもののみ残し、それ以外は無視する。
**/__screenshots__/*.test.browser.ts/*
**/__screenshots__/*.test.browser.tsx/*
!**/__screenshots__/*.test.browser.ts/*-chromium-linux.png
!**/__screenshots__/*.test.browser.tsx/*-chromium-linux.png

.gitignore
.vitest/
