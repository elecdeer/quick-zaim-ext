{
  "$schema": "https://biomejs.dev/schemas/1.9.3/schema.json",
  "formatter": {
    "enabled": true
  },
  "organizeImports": {
    "enabled": true
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "linter": {
    "enabled": true,
    "ignore": ["packages/extention/entrypoints/playwright/**/*.ts"],
    "rules": {
      "recommended": true,
      "correctness": {
        "useHookAtTopLevel": "warn"
      },
      "suspicious": {
        "useAwait": "warn"
      }
    }
  }
}
