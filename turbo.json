{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "generate": {
      "outputs": ["src/generated/**", "tsp-output/**"]
    },
    "build": {
      "dependsOn": ["^generate", "generate", "^build:types"],
      "outputs": ["dist/**", ".output/**"]
    },
    "build:types": {
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^generate"],
      "persistent": true,
      "cache": false
    },
    "//#test": {
      "cache": true
    }
  }
}
