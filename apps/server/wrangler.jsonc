{
  "name": "quick-zaim-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-13",
  "compatibility_flags": ["nodejs_compat"],
  // Cloudflare Workers の自動トレーシング。workerd が全 I/O（fetch / AI / KV など）を
  // 自動で span 化し、Workers ダッシュボードで確認できる。デバッグ目的なので head
  // サンプリング率は 100% に固定。本番投入時にコスト都合で下げる場合は 0.05 等へ。
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
    },
  },
  // 平文の環境変数（シークレットは `wrangler secret put <NAME>` で別途登録）
  "vars": {
    // Workers AI で叩くデフォルトモデル ID。差し替え可能。
    "LLM_MODEL": "openai/gpt-5.4-mini",
  },
  // Workers AI binding（リクエストハンドラから env.AI として参照）
  // remote: true は wrangler dev / getPlatformProxy で実 Workers AI を叩くために必須。
  // Workers AI は本番のみ提供されローカルエミュレーションが存在しないため、
  // ローカル開発・評価スクリプトでも実際の Cloudflare アカウントの利用枠を消費する。
  "ai": { "binding": "AI", "remote": true },
  // KV ネームスペース
  // 本番用 ID は `wrangler kv namespace create ZAIM_KV` で取得してください
  "kv_namespaces": [
    {
      "binding": "ZAIM_KV",
      "id": "c1d27951ac224c628ed6a43b216dd6f3",
      // ローカル開発用プレビュー ID（wrangler dev では自動的にローカル KV を使用）
      "preview_id": "5ab6407251a04dda90faad8f95a9f76f",
    },
  ],
  // 認証は Worker の手前の Cloudflare Access が行い、Worker は ctx.access からユーザーを取り出す。
  // wrangler dev では Access がないため、dev ブロックで認証済みユーザーを再現する。
  // aud は ctx.access.aud として見えるだけでアプリでは検証しないので、ローカル用の任意値でよい。
  // 未認証状態を試すときは dev ブロックを外す。
  "access": {
    "dev": {
      "aud": "local-dev",
      "identity": { "email": "dev@example.com" },
    },
  },
  // `wrangler preview` で作るブランチごとの Preview 用設定。
  // Preview は本番の vars / bindings / observability を引き継がないため、必要なものはここで再定義する。
  // シークレットは本番とは別に `wrangler preview base-config secret put <NAME>` で登録する。
  "previews": {
    "observability": {
      "logs": {
        "enabled": true,
        "invocation_logs": true,
      },
      "traces": {
        "enabled": true,
        "head_sampling_rate": 1,
      },
    },
    "vars": {
      "LLM_MODEL": "openai/gpt-5.4-mini",
    },
    "ai": { "binding": "AI" },
    // 本番 KV を汚さないよう、全 Preview で共有する Preview 専用ネームスペースを使う。
    // 共有にしているのは、Zaim 連携（KV 上のアクセストークン）を Preview ごとにやり直さずに済ませるため。
    "kv_namespaces": [
      {
        "binding": "ZAIM_KV",
        "id": "5ab6407251a04dda90faad8f95a9f76f",
      },
    ],
  },
}
