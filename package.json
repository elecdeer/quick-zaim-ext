{
  "name": "tsuke",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp run ledger#build:types && vp check && vp run -r test && vp run -r build",
    "dev": "vp run --filter=ledger --filter=extension --parallel dev",
    "test": "vp test run",
    "test:browser": "docker compose -f docker-compose.vrt.yml run --build --rm vrt",
    "test:browser:update": "docker compose -f docker-compose.vrt.yml run --build --rm vrt pnpm run test:browser --update",
    "prepare": "node -e \"if(!process.env.CI)require('child_process').execSync('vp config',{stdio:'inherit'})\""
  },
  "devDependencies": {
    "@vitejs/plugin-react": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.14.0"
}
