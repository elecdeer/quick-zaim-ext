{
  "$schema": "https://biomejs.dev/schemas/1.9.3/schema.json",
  "formatter": {
    "enabled": true,
    "formatWithErrors": true
  },
  "organizeImports": {
    "enabled": true
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "linter": {
    "enabled": true,
    "ignore": [
      "packages/extention/entrypoints/playwright/**/*.ts",
      "packages/zaim-api/src/client/**"
    ],
    "rules": {
      "recommended": true,
      "correctness": {
        "useHookAtTopLevel": "warn",
        "noUnusedImports": "warn"
      },
      "suspicious": {
        "useAwait": "warn"
      },
      "nursery": {
        "useSortedClasses": "warn"
      }
    }
  }
}
