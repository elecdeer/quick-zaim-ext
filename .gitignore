# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Wrangler
.wrangler/
.dev.vars

# Local environment files for scripts (e.g. eval scripts)
.env

# LLM eval script outputs
apps/server/scripts/eval-results/

# AI agent worktrees
.claude/worktrees/

# WXT extension build output
.output/

# Storybook build output
storybook-static/

# WXT generated types (auto-generated by wxt prepare / pnpm install)
.wxt/

# Vitest browser test attachments (差分・失敗時スクリーンショット。参照画像は __screenshots__/ で管理)
.vitest-attachments/

# Vitest browser-mode が非 visual な *.test.browser.{ts,tsx} に対しても
# __screenshots__/ を自動生成するため無視する。
# visual regression 用の *.visual.test.browser.{ts,tsx} の参照画像のみ残す。
**/__screenshots__/*.test.browser.ts/
**/__screenshots__/*.test.browser.tsx/
!**/__screenshots__/*.visual.test.browser.ts/
!**/__screenshots__/*.visual.test.browser.tsx/

.gitignore
packages/zaim-api/src/generated/
packages/zaim-api/tsp-output/