{
  "name": "quick-zaim-ext",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp run -r generate && vp check && vp run -r test && vp run -r build",
    "dev": "vp run --filter=server --filter=extension --parallel dev",
    "build:server": "vp run --filter=server build",
    "version:upload": "vp run server#version:upload",
    "test": "vitest run",
    "test:browser": "docker compose -f docker-compose.vrt.yml run --build --rm vrt",
    "test:browser:update": "docker compose -f docker-compose.vrt.yml run --build --rm vrt pnpm run test:browser -- --update",
    "prepare": "node -e \"if(!process.env.CI)require('child_process').execSync('vp config',{stdio:'inherit'})\""
  },
  "devDependencies": {
    "@hono/cli": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.1.1"
}
